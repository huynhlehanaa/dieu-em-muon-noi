# Neon PostgreSQL Connection URL
# Lấy từ: https://console.neon.tech → Project → Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret (chuỗi random ít nhất 32 ký tự)
JWT_SECRET=your-super-secret-jwt-key-here-change-this-min-32-chars

# Thông tin tài khoản admin
ADMIN_USERNAME=admin_doan_tralien

# Salt (chuỗi random, dùng để bảo vệ mật khẩu)
PASSWORD_SALT=your-random-salt-string-here

# Hash mật khẩu (tạo bằng: node scripts/generate-hash.js <password> <salt>)
ADMIN_PASSWORD_HASH=your-sha256-password-hash-here
